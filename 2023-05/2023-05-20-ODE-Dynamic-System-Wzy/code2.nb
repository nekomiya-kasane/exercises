Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol", "=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Laplacian", "[", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "y", ",", "t"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "==", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "y", ",", "t"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "2"}], "}"}]}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y", ",", "0"}], "]"}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{
         RowBox[{"-", "L"}], ",", "y", ",", "t"}], "]"}], "==", 
       RowBox[{"u", "[", 
        RowBox[{"L", ",", "y", ",", "t"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", 
         RowBox[{"-", "L"}], ",", "t"}], "]"}], "==", 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "L", ",", "t"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "0", ",", "1"}], "]"}], "[", "u", "]"}], "[", 
        RowBox[{"x", ",", "y", ",", "0"}], "]"}], "==", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Erfc", "[", 
           RowBox[{"10", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "^", "2"}], "+", 
              RowBox[{"y", "^", "2"}], "-", "1"}], ")"}]}], "]"}], "+", "1"}],
          ")"}]}]}]}], "}"}], ",", "u", ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
    RowBox[{"{", 
