% oscillation
ks = [-0.05, 0, 1, 2, 2.05];
n = length(ks);
sys = cell(1, n);
for i = 1:n
    G = tf([ks(i), 10 * ks(i)], [1, 4, 3, 0]);
    H = tf(1, 1);
    T = feedback(G, H);
    sys{i} = T;
end

for i = 1:n
    subplot(2, 5, mod(n, 5) + 1)
    impulseplot(sys{1}, sys{2}, sys{3}, sys{4}, sys{5}, 20)
    subplot(2, 5, mod(n, 5) + 1)
    impulse(sys, 50)
end