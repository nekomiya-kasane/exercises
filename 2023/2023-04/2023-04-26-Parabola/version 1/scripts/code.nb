Cell[BoxData[
 RowBox[{
  RowBox[{"curves2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", "=", "i"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "4"}], 
             SuperscriptBox["#", "3"]}], "+", 
            RowBox[{"4", 
             SuperscriptBox["#", "2"]}], "-", "#"}], ")"}], 
          RowBox[{"Ps", "[", 
           RowBox[{"[", 
            RowBox[{"i", "-", "1"}], "]"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"12", 
             SuperscriptBox["#", "3"]}], "-", 
            RowBox[{"10", 
             SuperscriptBox["#", "2"]}], "+", "1"}], ")"}], 
          RowBox[{"Ps", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "12"}], 
             SuperscriptBox["#", "3"]}], "+", 
            RowBox[{"8", 
             SuperscriptBox["#", "2"]}], "+", "#"}], ")"}], 
          RowBox[{"Ps", "[", 
           RowBox[{"[", 
            RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"4", 
             SuperscriptBox["#", "3"]}], "-", 
            RowBox[{"2", 
             SuperscriptBox["#", "2"]}]}], ")"}], 
          RowBox[{"Ps", "[", 
