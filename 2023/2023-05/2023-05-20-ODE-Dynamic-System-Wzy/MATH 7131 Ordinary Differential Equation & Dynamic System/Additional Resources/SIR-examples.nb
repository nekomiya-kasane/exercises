Cell[CellGroupData[{
Cell["\<\
Differential equations, numerical solutions and visualisation\
\>", "Section",
 CellChangeTimes->{{3.796248612321302*^9, 
  3.796248631199218*^9}},ExpressionUUID->"af3c690a-f878-4dfb-aea0-\
6ccc75e2c079"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "parameters", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"b", "=", "3"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"k", "=", "1"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"recovery", " ", "rate"}], " ", "=", "  ", 
     RowBox[{
      RowBox[{"1", "/", " ", "expected"}], " ", "duration", " ", 
      RowBox[{"til", " ", "'"}], 
      RowBox[{"recovery", "'"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"threshold", "=", "0.2"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"representing", " ", 
     RowBox[{"e", ".", "g", ".", " ", "saturation"}], " ", "of", " ", 
     "health", " ", "care", " ", "facilities"}], " ", "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"x", " ", "=", " ", "susceptible"}], ",", " ", 
     RowBox[{"y", "=", " ", "infectious"}], ",", " ", 
     RowBox[{"z", "=", " ", "removed"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"X", "[", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "]"}], "=", 
     RowBox[{
      RowBox[{"-", " ", "b"}], " ", "x", " ", "y"}]}], " ", ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Y", "[", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "]"}], "=", " ", 
     RowBox[{
      RowBox[{"b", " ", "x", " ", "y"}], " ", "-", 
      RowBox[{"k", " ", "y"}]}]}], " ", ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Z", "[", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "]"}], "=", " ", 
     RowBox[{"k", " ", "y"}]}], " ", ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"time", " ", "&"}], " ", "initial", " ", "conditions"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tmin", "=", "0"}], ";", " ", 
    RowBox[{"tmax", "=", "50"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s0", "=", "0.9999"}], ";", " ", 
    RowBox[{"i0", "=", 
     RowBox[{"1", "-", "s0"}]}], ";", " ", 
    RowBox[{"r0", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"numerical", " ", "solution"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ivp1", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
        RowBox[{"X", "[", 
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], ",", 
          RowBox[{"y", "[", "t", "]"}], ",", 
          RowBox[{"z", "[", "t", "]"}]}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "\[Equal]", 
        RowBox[{"Y", "[", 
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], ",", 
          RowBox[{"y", "[", "t", "]"}], ",", 
          RowBox[{"z", "[", "t", "]"}]}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"z", "'"}], "[", "t", "]"}], "\[Equal]", 
        RowBox[{"Z", "[", 
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], ",", 
          RowBox[{"y", "[", "t", "]"}], ",", 
          RowBox[{"z", "[", "t", "]"}]}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "\[Equal]", "s0"}], ",", " ", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "\[Equal]", "i0"}], ",", 
       RowBox[{
        RowBox[{"z", "[", "0", "]"}], "==", "r0"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"solveivp1", "[", "t_", "]"}], "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "[", "t", "]"}], ",", 
        RowBox[{"y", "[", "t", "]"}], ",", 
        RowBox[{"z", "[", "t", "]"}]}], "}"}], "/.", " ", 
      RowBox[{"NDSolve", "[", 
       RowBox[{"ivp1", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], ",", 
          RowBox[{"y", "[", "t", "]"}], ",", 
          RowBox[{"z", "[", "t", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "plots", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"threshold", ",", " ", 
       RowBox[{
        RowBox[{"b", " ", 
         RowBox[{
          RowBox[{"solveivp1", "[", "t", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], " ", "-", " ", "k"}], ",", 
       RowBox[{
        RowBox[{"solveivp1", "[", "t", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"solveivp1", "[", "t", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "3"}], "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"solveivp1", "[", "t", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\"\<thresh\>\"", ",", " ", "\"\<b S-k\>\"", ",", "\"\<S\>\"", ",", 
        " ", "\"\<R\>\"", ",", " ", "\"\<I\>\""}], "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RGBColor", "[", 
           RowBox[{"0.5", ",", "0.5", ",", "0.5"}], "]"}], ",", "Dashed"}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RGBColor", "[", 
           RowBox[{"1", ",", "0", ",", "1"}], "]"}], ",", "Dashed"}], "}"}], 
        ",", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0", ",", "0", ",", "1"}], "]"}], ",", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0", ",", "1", ",", "0"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RGBColor", "[", 
           RowBox[{"1", ",", "0", ",", "0"}], "]"}], ",", "Thick"}], "}"}]}], 
       "}"}]}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"tmin", ",", "tmax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}]}], "]"}]}]}]], "Input",
