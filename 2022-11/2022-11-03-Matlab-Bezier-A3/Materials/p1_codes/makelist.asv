function [lnodes] = makelist(lpoly)
total = length(lpoly(1,:,1));
lnodes = zeros(2, (total-1)*2^length(lpoly(1,1))+1);
for i = 1: 4
    lnodes(:,i) = lpoly(:,i,1);
end
for j = 2: (2^length(lpoly(1,1)))
    for k = 2: 4
        cur = ((j - 2) * 3 + (k - 1)) + 4;
        lnodes(:,cur) = lpoly(:,k,j);
    end
end
