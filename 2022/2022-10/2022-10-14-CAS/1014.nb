 RowBox[{
  RowBox[{"r5", "[", "t_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"3", 
     RowBox[{"Cos", "[", "t", "]"}]}], ",", 
    RowBox[{"3", 
     RowBox[{"Sin", "[", "t", "]"}]}], ",", "t"}], "}"}]}]], "Input",
