Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{"4", "-", 
     RowBox[{"4", " ", 
      SuperscriptBox["t", "2"]}]}], 
    RowBox[{"1", "+", 
     SuperscriptBox["t", "2"]}]], ",", 
   FractionBox[
    RowBox[{"8", " ", "t"}], 
    RowBox[{"1", "+", 
