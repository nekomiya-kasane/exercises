  "In[232]:=",ExpressionUUID->"7c97de40-99b7-48a8-8e8a-29673a58ec4e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"res", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{"r5", "'"}], "[", "t", "]"}], "]"}], 
     RowBox[{
      RowBox[{"Det", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"r4", "'"}], "[", "t", "]"}], ",", 
         RowBox[{
          RowBox[{"r4", "''"}], "[", "t", "]"}]}], "}"}], "]"}], "/", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{"r4", "'"}], "[", "t", "]"}], "]"}], "^", "3"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", 
      RowBox[{"4", "Pi"}]}], "}"}]}], "]"}]}]], "Input",
