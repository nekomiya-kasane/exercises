Cell["Problem 3", "Subsubsection",
 CellChangeTimes->{{3.874698269899479*^9, 
  3.874698271156206*^9}},ExpressionUUID->"9aea1f93-0166-4bf0-8a12-\
94ff8d1181cd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"r5", "[", "t_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"2", 
     RowBox[{"t", "^", "2"}]}], ",", 
    RowBox[{
     RowBox[{
      FractionBox["2", "3"], 
      RowBox[{"t", "^", "3"}]}], "-", 
     RowBox[{"2", "t"}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.8746986739120646`*^9, 3.8746986949430065`*^9}},
 CellLabel->
  "In[185]:=",ExpressionUUID->"f53cbb20-cc02-4270-9d1e-bfdb4cf6375b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"a5", "[", "t_", "]"}], ":=", 
  RowBox[{
   RowBox[{"r5", "''"}], "[", "t", "]"}]}]], "Input",
 CellChangeTimes->{{3.8746989142593293`*^9, 3.874698923988736*^9}},
 CellLabel->
  "In[211]:=",ExpressionUUID->"6d40dc71-90da-4da8-bfcd-d035091e200d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Tangential", " ", "*)"}], " ", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Projection", "[", 
      RowBox[{
       RowBox[{"a5", "[", "t", "]"}], ",", 
       RowBox[{
        RowBox[{"r5", "'"}], "[", "t", "]"}]}], "]"}], ",", 
     RowBox[{"t", "\[Element]", "Reals"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "Normal", " ", "*)"}], " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Projection", "[", 
      RowBox[{
       RowBox[{"a5", "[", "t", "]"}], ",", 
       RowBox[{"Cross", "[", 
        RowBox[{
         RowBox[{"r5", "'"}], "[", "t", "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"t", "\[Element]", "Reals"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"%", " ", "+", " ", "%%"}], "\[Equal]", 
     RowBox[{"a5", "[", "t", "]"}]}], "//", "Simplify"}]}]}]], "Input",
 CellChangeTimes->{{3.874698721733632*^9, 3.8746988462629075`*^9}, {
  3.874698927109812*^9, 3.8746990758053875`*^9}},
 CellLabel->
  "In[229]:=",ExpressionUUID->"9e0ae7d4-02e2-46b8-b1f2-5e8ddc45eed2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{"8", " ", 
     SuperscriptBox["t", "2"]}], 
    RowBox[{"1", "+", 
     SuperscriptBox["t", "2"]}]], ",", 
   FractionBox[
    RowBox[{"4", " ", "t", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["t", "2"]}], ")"}]}], 
    RowBox[{"1", "+", 
     SuperscriptBox["t", "2"]}]]}], "}"}]], "Output",
 CellChangeTimes->{{3.874698794343753*^9, 3.874698859066392*^9}, {
  3.8746989956997457`*^9, 3.874699079215149*^9}},
