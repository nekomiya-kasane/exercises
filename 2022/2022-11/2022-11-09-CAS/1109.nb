Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{"1", "-", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"x", "^", "2"}]}], "-", 
     RowBox[{"2", 
      RowBox[{"y", "^", "2"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.8769117657326813`*^9, 3.876911780044958*^9}},
