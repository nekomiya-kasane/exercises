 CellLabel->"In[6]:=",ExpressionUUID->"d670cae1-b8fc-40f8-8bbf-13c6526cdd37"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"(", 
    InterpretationBox[
     RowBox[{
      RowBox[{"2", " ", 
       SuperscriptBox["y", "2"]}], "+", 
      InterpretationBox[
       SuperscriptBox[
        RowBox[{"O", "[", "y", "]"}], "3"],
       SeriesData[$CellContext`y, 0, {}, 2, 3, 1],
       Editable->False]}],
     SeriesData[$CellContext`y, 0, {2}, 2, 3, 1],
     Editable->False], ")"}], "+", 
   RowBox[{
    RowBox[{"(", 
     InterpretationBox[
      RowBox[{"1", "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["y", "2"]}], "+", 
       InterpretationBox[
        SuperscriptBox[
         RowBox[{"O", "[", "y", "]"}], "3"],
        SeriesData[$CellContext`y, 0, {}, 0, 3, 1],
        Editable->False]}],
      SeriesData[$CellContext`y, 0, {1, 0, -2}, 0, 3, 1],
      Editable->False], ")"}], " ", 
    SuperscriptBox["x", "2"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "x", "]"}], "3"],
    SeriesData[$CellContext`x, 0, {}, 0, 3, 1],
    Editable->False]}],
  SeriesData[$CellContext`x, 0, {
    SeriesData[$CellContext`y, 0, {2}, 2, 3, 1], 0, 
    SeriesData[$CellContext`y, 0, {1, 0, -2}, 0, 3, 1]}, 0, 3, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.8769118184038076`*^9, 3.8769118773093767`*^9}},
