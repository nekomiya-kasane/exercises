A = [[-1, 1]; [1, -1000]];
f = @(t, y) A * y + [2*sin(t);1000*(cos(t)-sin(t))];

y0 = [1;2];
span = [0,30];
N = 3e6;

warning('off','all')
[ts, ys] = method3(f, span, y0, N);
plot(ts,ys)

if ishandle(1)
    saveas(gcf, "md3.png");
    close all
end

function [xs, ys] = method3(f, x_range, y0, num_steps)
    arguments
        f % real 2 col vec
        x_range
        y0 % col vec
        num_steps = 100
    end
    
    h = (x_range(2) - x_range(1)) / num_steps;
    xs = x_range(1) : h : x_range(2);
    
    ys(1, :) = y0'; % col vec 2 row vec
    yps(1, :) = transpose(feval(f, xs(1), y0));

    % ys(1:3, :) = runge_kutta_4(f, xs(1:3), y0, h)';
    tmp = runge_kutta_4(f, xs(1):h:xs(3), y0, h)';
    ys(2, :) = tmp(1, :);
    ys(3, :) = tmp(2, :);
    for i = 1:3
        yps(i, :) = feval(f, xs(i), ys(i, :)')';
    end
    
    wb = waitbar(0, "Waiting");
    for k = 3 : num_steps
        waitbar(k / num_steps, wb, "step " + k + "/" );

        finder = @(y) y-18/11*ys(k)+9/11*ys(k-1)-2/11*ys(k-2)-6/11*h*f(xs(k+1),y);
        ys(k + 1, :) = fsolve(finder, zeros(2,1), optimset('display','off'))';
        
        if k < num_steps
            yps(k + 1, :) = feval(f, xs(k + 1), ys(k + 1, :)')';
        end
    end

    close(wb)
end

function ys = runge_kutta_4(f, ts, y0, h)
    ys = zeros(2, length(ts));
    ys(:, 1) = y0;
    for n = 1 : length(ts) - 1
        k1 = feval(f, ts(n), ys(:, n));
        k2 = feval(f, ts(n) + 0.5 * h, ys(:, n) + 0.5 * h * k1);
        k3 = feval(f, ts(n) + 0.5 * h, ys(:, n) + 0.5 * h * k2);
        k4 = feval(f, ts(n) + h, ys(:, n) + h * k3);
        ys(:, n + 1) = ys(:, n) + h * (k1 + 2 * k2 + 2 * k3 + k4) / 6;
    end
end
