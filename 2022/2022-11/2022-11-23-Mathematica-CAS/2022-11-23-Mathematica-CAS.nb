  3.878173908220953*^9}},ExpressionUUID->"6b2e3d69-bd17-4305-91e1-\
d0d4a9df4214"],

Cell[BoxData[
 RowBox[{
  RowBox[{"F", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"x", "^", "2"}], "+", 
   RowBox[{"y", "^", "3"}], "-", "y"}]}]], "Input",
 CellChangeTimes->{{3.8781603401505013`*^9, 3.878160348115133*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"9c916564-6cc5-48d1-9e4f-5a9d35c57f7b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"S", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Grad", "[", 
      RowBox[{
       RowBox[{"F", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "==", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.878160376350171*^9, 3.878160394141369*^9}, {
  3.87816049598935*^9, 3.878160496139127*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"ff11c237-3ca2-4055-9e42-39b75fcc80c9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", "0"}], ",", 
     RowBox[{"y", "\[Rule]", 
      RowBox[{"-", 
       FractionBox["1", 
        SqrtBox["3"]]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", "0"}], ",", 
     RowBox[{"y", "\[Rule]", 
      FractionBox["1", 
       SqrtBox["3"]]}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.8781603945335407`*^9, 3.8781604964310102`*^9},
 CellLabel->"Out[19]=",ExpressionUUID->"c63bc80c-a30d-45b6-b910-b7451f9aa2e1"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Pts", " ", "=", " ", 
  RowBox[{"MapThread", "[", 
   RowBox[{"Append", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"S", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], ",", 
      RowBox[{"F", "@@@", 
       RowBox[{"S", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}]}]}], "}"}]}], 
   "]"}]}]], "Input",
