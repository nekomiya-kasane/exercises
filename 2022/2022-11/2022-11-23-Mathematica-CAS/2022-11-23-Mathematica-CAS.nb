Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"3", " ", "x", " ", "y"}], "+", 
    RowBox[{"18", " ", 
     SuperscriptBox["t", "2"], " ", "x", " ", "y"}], "+", 
    RowBox[{"9", " ", 
     SuperscriptBox["t", "2"], " ", "x", " ", 
     SuperscriptBox["y", "2"]}]}], ",", 
   RowBox[{
    RowBox[{"6", " ", "y"}], "+", 
    RowBox[{"36", " ", 
     SuperscriptBox["t", "2"], " ", "y"}]}], ",", 
   RowBox[{
    RowBox[{"x", " ", "y", " ", "z"}], "+", 
