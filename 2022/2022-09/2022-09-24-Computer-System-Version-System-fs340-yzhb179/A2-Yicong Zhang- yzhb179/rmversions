import os, sys
import re
import shutil

root = os.path.join(os.getcwd(), '.versiondir')

def rm(filename):
    full_filename = full_path(filename)
    base_filename = os.path.basename(full_filename) 

    versioned_re = re.compile('^' + base_filename + '\\.(\\d+)$')

    res = os.listdir(root) if os.path.isdir(root) else []
    res = list(filter(lambda x: versioned_re.search(x), res))
    res.sort(key=lambda x: int(versioned_re.search(x)[1]))

    if not len(res):
        return

    for i in range(1, len(res)):
        os.remove(full_path(res[i]))

def full_path(partial):
    partial = (partial[1:] if partial.startswith("/") else partial)
    path = os.path.join(root, partial)
    return path

if __name__ == '__main__':
    if len(sys.argv) < 2:
        print("Usage: ./rmversions [file]")
        exit(0)
    rm(sys.argv[1])
