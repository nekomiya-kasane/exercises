Notebook[{

Cell[CellGroupData[{
Cell["Problem 1", "Subsubsection",
 CellChangeTimes->{{3.8731673743357897`*^9, 
  3.8731673856567755`*^9}},ExpressionUUID->"05a01681-c85f-42d2-818d-\
03b0750cb11e"],

Cell[TextData[{
 "Since  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", 
        RowBox[{"tCos", "[", "t", "]"}]}], ")"}], "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", 
        RowBox[{"tSin", "[", "t", "]"}]}], ")"}], "2"]}], "=", 
    RowBox[{"4", 
     SuperscriptBox["t", "2"]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "a190a7db-e46b-4b6b-a2a5-68a0fcbc14da"],
 " increases with respect to t, to plot the part within the Disk[{0,0},3], we \
only need to let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"4", 
     SuperscriptBox["t", "2"]}], "\[LessEqual]", " ", 
    SuperscriptBox["3", "2"]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "281c91fb-5fa0-45f0-b270-f69d5096af01"]
}], "Text",
 CellChangeTimes->{{3.8731667596817675`*^9, 3.873166845080656*^9}, {
  3.8731669636718874`*^9, 3.873167011160757*^9}, {3.8731673723126397`*^9, 
  3.8731673733360915`*^9}},ExpressionUUID->"062461a2-2178-40ba-878f-\
469bfd113521"],

Cell[CellGroupData[{

