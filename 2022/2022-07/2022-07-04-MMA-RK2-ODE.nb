Cell[BoxData[
 RowBox[{
  RowBox[{"F", "[", "x_", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"y", "'"}], "[", "x", "]"}], "-", 
          RowBox[{
           RowBox[{"y", "[", "x", "]"}], "^", "2"}]}], "==", 
         RowBox[{"x", "^", "2"}]}], ",", 
        RowBox[{
         RowBox[{"y", "[", "0", "]"}], "\[Equal]", 
         RowBox[{"1", "/", "2"}]}]}], "}"}], ",", 
      RowBox[{"y", "[", "x", "]"}], ",", "x"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "//", 
   "Simplify"}]}]], "Input",
