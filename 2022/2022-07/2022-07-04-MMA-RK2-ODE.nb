         "\[IndentingNewLine]", 
         RowBox[{"k1", "=", 
          RowBox[{"G", "[", 
           RowBox[{"xx", ",", "yy"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"k2", "=", 
          RowBox[{"G", "[", 
           RowBox[{
            RowBox[{"xx", "+", "StepSize"}], ",", 
