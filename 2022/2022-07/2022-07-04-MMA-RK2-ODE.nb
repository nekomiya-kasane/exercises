Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["x", "2"]}], " ", 
    RowBox[{"BesselJ", "[", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["3", "4"]}], ",", 
      FractionBox[
       SuperscriptBox["x", "2"], "2"]}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     FractionBox["1", "4"], "]"}]}], "+", 
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["x", "2"], " ", 
       RowBox[{"BesselJ", "[", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["5", "4"]}], ",", 
         FractionBox[
          SuperscriptBox["x", "2"], "2"]}], "]"}]}], "+", 
      RowBox[{"BesselJ", "[", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "4"]}], ",", 
        FractionBox[
         SuperscriptBox["x", "2"], "2"]}], "]"}], "-", 
      RowBox[{
       SuperscriptBox["x", "2"], " ", 
       RowBox[{"BesselJ", "[", 
        RowBox[{
         FractionBox["3", "4"], ",", 
         FractionBox[
          SuperscriptBox["x", "2"], "2"]}], "]"}]}]}], ")"}], " ", 
    RowBox[{"Gamma", "[", 
     FractionBox["3", "4"], "]"}]}]}], 
  RowBox[{"x", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"BesselJ", "[", 
       RowBox[{
        FractionBox["1", "4"], ",", 
        FractionBox[
         SuperscriptBox["x", "2"], "2"]}], "]"}], " ", 
      RowBox[{"Gamma", "[", 
       FractionBox["1", "4"], "]"}]}], "-", 
     RowBox[{"4", " ", 
      RowBox[{"BesselJ", "[", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "4"]}], ",", 
        FractionBox[
