      RowBox[{"yy", "=", 
       RowBox[{"1", "/", "2"}]}], ";", 
      RowBox[{"Error", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"xx", "=", "0"}], ",", 
