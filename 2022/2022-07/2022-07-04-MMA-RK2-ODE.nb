             RowBox[{"StepSize", "*", "k1"}]}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"yy", "=", 
          RowBox[{"yy", "+", 
           RowBox[{"0.5", "*", "StepSize", "*", 
