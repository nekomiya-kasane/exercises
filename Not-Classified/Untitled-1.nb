Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     SqrtBox[
      RowBox[{"4", "-", 
       RowBox[{"x", "^", "2"}], "-", 
       RowBox[{"z", "^", "2"}]}]], "<=", 
     RowBox[{"1", "+", 
      RowBox[{"2", "x"}]}]}], "&&", 
    RowBox[{"x", ">=", "0"}], "&&", 
    RowBox[{"z", ">=", "0"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "z"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.894556643469797*^9, 3.8945566677021723`*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"fa9f6695-e900-4e28-9e90-4d0f11f18f39"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"0", "\[LessEqual]", "x", "<", 
     RowBox[{
      FractionBox["1", "5"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "+", 
        SqrtBox["19"]}], ")"}]}]}], "&&", 
    RowBox[{
     SqrtBox[
      RowBox[{"3", "-", 
       RowBox[{"4", " ", "x"}], "-", 
       RowBox[{"5", " ", 
        SuperscriptBox["x", "2"]}]}]], "\[LessEqual]", "z", "\[LessEqual]", 
     SqrtBox[
      RowBox[{"4", "-", 
       SuperscriptBox["x", "2"]}]]}]}], ")"}], "||", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["1", "5"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "+", 
        SqrtBox["19"]}], ")"}]}], "\[LessEqual]", "x", "<", "2"}], "&&", 
    RowBox[{"0", "\[LessEqual]", "z", "\[LessEqual]", 
     SqrtBox[
      RowBox[{"4", "-", 
       SuperscriptBox["x", "2"]}]]}]}], ")"}], "||", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"x", "\[Equal]", "2"}], "&&", 
    RowBox[{"z", "\[Equal]", "0"}]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.894556651744894*^9, 3.8945566679869385`*^9}},
 CellLabel->"Out[46]=",ExpressionUUID->"05b026a9-b785-413f-a766-abd3b8fa515c"]
}, Open  ]],

