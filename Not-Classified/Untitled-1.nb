Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"reg", "=", 
   RowBox[{"ImplicitRegion", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"x", ">=", "0"}], "&&", 
      RowBox[{"y", ">=", "0"}], "&&", 
      RowBox[{"z", ">", "0"}], "&&", 
      RowBox[{"y", "<=", 
       RowBox[{"1", "+", 
        RowBox[{"2", "x"}]}]}], "&&", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "^", "2"}], "+", 
        RowBox[{"y", "^", "2"}], "+", 
        RowBox[{"z", "^", "2"}]}], "<=", "4"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RegionPlot", "[", 
   RowBox[{
    RowBox[{"Resolve", "[", 
     RowBox[{
      RowBox[{"Exists", "[", 
       RowBox[{
        RowBox[{"{", "z", "}"}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], "\[Element]", "reg"}]}], 
       "]"}], ",", "Reals"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", ".05"}], ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", ".05"}], ",", "2"}], "}"}], ",", 
    RowBox[{"PlotPoints", "->", "50"}]}], "]"}], 
  RowBox[{"(*", "xy", "*)"}]}]}], "Input",
 CellChangeTimes->{{3.8945551692716227`*^9, 
  3.894555281213148*^9}},ExpressionUUID->"4ba2354c-b822-42f0-914c-\
0b819c002ded"],

