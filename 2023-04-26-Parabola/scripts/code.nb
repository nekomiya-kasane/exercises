     RowBox[{"{", 
      RowBox[{"i", ",", "2", ",", 
       RowBox[{
        RowBox[{"Length", "@", "Ps"}], "-", "2"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
