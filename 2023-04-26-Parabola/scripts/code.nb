Cell[BoxData[
 RowBox[{
  RowBox[{"innerCurves", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", "=", "k"}], "}"}], ",", 
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"2", "#"}]}], ")"}], 
           RowBox[{
            RowBox[{"curves", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"#", "+", "0.5"}], "]"}]}], "+", 
          RowBox[{"2", "#", " ", 
           RowBox[{
            RowBox[{"curves", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}], "[", "#", "]"}]}]}], 
         "&"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", 
       RowBox[{
        RowBox[{"Length", "@", "curves"}], "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.8913127034782667`*^9, 3.8913127914146223`*^9}, {
