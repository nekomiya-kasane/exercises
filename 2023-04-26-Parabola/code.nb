Cell[BoxData[
 RowBox[{
  RowBox[{"curves", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", "=", "i"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"3", "#"}], "+", 
            RowBox[{"2", 
             RowBox[{"#", "^", "2"}]}]}], ")"}], 
          RowBox[{"Ps", "[", 
           RowBox[{"[", 
            RowBox[{"i", "-", "1"}], "]"}], "]"}]}], "+", 
         RowBox[{"4", "#", 
          RowBox[{"(", 
           RowBox[{"1", "-", "#"}], ")"}], 
          RowBox[{"Ps", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "#"}], "+", 
            RowBox[{"2", 
             RowBox[{"#", "^", "2"}]}]}], ")"}], 
          RowBox[{"Ps", "[", 
           RowBox[{"[", 
            RowBox[{"i", "+", "1"}], "]"}], "]"}]}]}], "&"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2", ",", 
       RowBox[{
        RowBox[{"Length", "@", "Ps"}], "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.8913122379376335`*^9, 3.891312306472561*^9}},
