Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{"curvature", " ", "k", 
    RowBox[{"(", "t", ")"}]}], "=", 
   FractionBox[
    RowBox[{"|", 
     RowBox[{
      RowBox[{"c", "'"}], 
      RowBox[{"(", "t", ")"}], "\[Times]", 
      RowBox[{"c", "''"}], 
      RowBox[{"(", "t", ")"}]}], "|"}], 
    RowBox[{"|", 
     RowBox[{
      RowBox[{"c", "'"}], 
      RowBox[{"(", "t", ")"}]}], 
     SuperscriptBox["|", "3"]}]]}], "*)"}]], "Input",
 CellChangeTimes->{{3.8738369417235336`*^9, 3.873836949092573*^9}, {
  3.8738370603404055`*^9, 
  3.873837104938242*^9}},ExpressionUUID->"36fb6e0a-37e3-43ce-aa60-\
5c7ae23f2247"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"t", "\[Element]", "Reals"}], ",", 
   RowBox[{
    RowBox[{"k", "[", "t_", "]"}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"Norm", "[", 
       RowBox[{"Cross", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"r3", "'"}], "[", "t", "]"}], ",", 
         RowBox[{
          RowBox[{"r3", "''"}], "[", "t", "]"}]}], "]"}], "]"}], 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{"r3", "'"}], "[", "t", "]"}], "]"}], "^", "3"}]], "//", 
     "Simplify"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.8738369511102276`*^9, 3.8738369525542765`*^9}, {
  3.87383710893671*^9, 3.8738372409011745`*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"bac8e07c-87ab-4d80-8569-ea233e35b34e"],

Cell[BoxData[
 FractionBox["2", "9"]], "Output",
