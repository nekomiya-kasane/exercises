Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"2", "+", 
      SuperscriptBox["t", "2"]}], ")"}]}], ",", 
   SuperscriptBox["\[ExponentialE]", "t"], ",", 
   RowBox[{"2", "+", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", "t"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "t"}], ")"}]}]}]}], "}"}]], "Output",
