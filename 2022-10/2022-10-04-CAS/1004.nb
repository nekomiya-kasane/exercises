Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"c1", "\[Rule]", "1"}], ",", 
    RowBox[{"c2", "\[Rule]", "0"}], ",", 
    RowBox[{"c3", "\[Rule]", "2"}]}], "}"}], "}"}]], "Output",
