       RowBox[{
        RowBox[{"F", "'"}], "[", "Pi", "]"}], 
       RowBox[{"(", 
        RowBox[{"t", "-", "Pi"}], ")"}]}]}], ",", 
     RowBox[{
      RowBox[{"F", "[", 
       RowBox[{"3", 
