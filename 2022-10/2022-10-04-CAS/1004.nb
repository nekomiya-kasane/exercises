 RowBox[{"{", 
  RowBox[{"1", ",", "4", ",", "8"}], "}"}]], "Output",
 CellChangeTimes->{{3.873836628228314*^9, 3.873836632204322*^9}},
 CellLabel->"Out[4]=",ExpressionUUID->"ac2d09ae-9921-4584-9308-5fba46eb938a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rp", "[", "t_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"t", ",", 
    RowBox[{"E", "^", "t"}], ",", 
    RowBox[{"t", " ", 
     RowBox[{"E", "^", "t"}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"rp", "[", "t", "]"}], ",", "t"}], "]"}], "+", 
       RowBox[{"{", 
        RowBox[{"c1", ",", "c2", ",", "c3"}], "}"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{"t", "->", "0"}], "}"}]}], ")"}], "==", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"c1", ",", "c2", ",", "c3"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"rp", "[", "t", "]"}], ",", "t"}], "]"}], "+", 
     RowBox[{"{", 
      RowBox[{"c1", ",", "c2", ",", "c3"}], "}"}]}], "/.", "%"}], "//", 
   "Simplify"}], "//", "Flatten"}], "\[IndentingNewLine]"}], "Input",
