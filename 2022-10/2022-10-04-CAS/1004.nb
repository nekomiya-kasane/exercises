Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"r", "[", "t_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"ArcTan", "[", "t", "]"}], ",", 
    RowBox[{"2", 
     RowBox[{"E", "^", 
      RowBox[{"(", 
       RowBox[{"2", "t"}], ")"}]}]}], ",", 
    RowBox[{"8", "t", " ", 
     RowBox[{"E", "^", "t"}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", "'"}], "[", "0", "]"}]}], "Input",
 CellChangeTimes->{{3.873836576636425*^9, 3.8738366316840053`*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"9da1268d-44e4-4f47-a58a-27316f28118e"],

