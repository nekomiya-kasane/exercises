import os, sys
import re

root = os.path.join(os.getcwd(), '.versiondir')

def checkversion(filename, version):
    full_filename = full_path(filename, version)
    if not os.path.isfile(full_filename):
        print(filename + " of version " + str(version) + " not exists.")
        return
    try:
        res = open(full_filename, 'r', encoding="utf-8").read()
        print(res,end="")
    except:
        print("Failed to view file " + full_filename + " of version " + str(version))

def full_path(partial, version):
    partial = (partial[1:] if partial.startswith("/") else partial) + '.' + str(version)
    path = os.path.join(root, partial)
    return path

if __name__ == '__main__':
    if len(sys.argv) < 3:
        print("Usage: ./catversions [file] [version]")
        exit(0)
    checkversion(sys.argv[1], int(sys.argv[2]))
