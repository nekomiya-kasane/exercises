     RowBox[{
      RowBox[{"x", "^", "6"}], " ", 
      RowBox[{"Cos", "[", "y", "]"}]}], "+", 
     RowBox[{"5", 
      RowBox[{"Cos", "[", "x", "]"}], " ", 
      RowBox[{"y", "^", "4"}]}]}]}], "}"}]}]], "Input",
