   RowBox[{
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "b", "-", 
       SqrtBox[
        RowBox[{"1", "-", 
         RowBox[{"2", " ", "b"}], "+", 
         SuperscriptBox["b", "2"], "-", 
         RowBox[{"4", " ", "d"}]}]]}], ")"}]}], ">", "0"}], ",", "d"}], 
  "]"}]], "Input",
