Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"u", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "t"}], "}"}], ",", 
      TagBox[GridBox[{
         {"\[Piecewise]", GridBox[{
            {
             RowBox[{
              FractionBox["1", "2"], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 SuperscriptBox["\[ExponentialE]", 
                  RowBox[{"-", 
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "t"}], "+", "x"}], ")"}], "2"]}]], " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "t"}], "+", "x"}], ")"}]}], "+", 
                RowBox[{
                 SuperscriptBox["\[ExponentialE]", 
                  RowBox[{"-", 
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"t", "+", "x"}], ")"}], "2"]}]], " ", 
                 RowBox[{"(", 
                  RowBox[{"t", "+", "x"}], ")"}]}]}], ")"}]}], 
             RowBox[{"x", ">", "t", "\[GreaterEqual]", "0"}]},
            {
             RowBox[{
              FractionBox["1", "2"], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", 
                  SuperscriptBox["\[ExponentialE]", 
                   RowBox[{"-", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"t", "-", "x"}], ")"}], "2"]}]]}], " ", 
                 RowBox[{"(", 
                  RowBox[{"t", "-", "x"}], ")"}]}], "+", 
                RowBox[{
                 SuperscriptBox["\[ExponentialE]", 
                  RowBox[{"-", 
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"t", "+", "x"}], ")"}], "2"]}]], " ", 
                 RowBox[{"(", 
                  RowBox[{"t", "+", "x"}], ")"}]}]}], ")"}]}], 
             RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "t"}]},
            {"Indeterminate", 
             TagBox["True",
              "PiecewiseDefault",
              AutoDelete->True]}
           },
           AllowedDimensions->{2, Automatic},
           Editable->True,
           GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
